                                        "value": "application/json"
                                    }
                                ],
                                "cookie": [],
                                "body": "{\n    \"success\": false,\n    \"message\": \"Proveedor no autenticado\",\n    \"code\": 401\n}"
                            },
                            {
                                "name": "Forbidden",
                                "status": "Forbidden",
                                "code": 403,
                                "_postman_previewlanguage": "json",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                    }
                                ],
                                "cookie": [],
                                "body": "{\n    \"success\": false,\n    \"message\": \"Acceso denegado. Se requiere permiso: manual_payments:create\",\n    \"code\": 403\n}"
                            },
                            {
                                "name": "Internal Server Error",
                                "status": "Internal Server Error",
                                "code": 500,
                                "_postman_previewlanguage": "json",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                    }
                                ],
                                "cookie": [],
                                "body": "{\n    \"success\": false,\n    \"message\": \"Error interno del servidor\",\n    \"code\": 500\n}"
                            }
                        ]
                    }
